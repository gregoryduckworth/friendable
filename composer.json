{
    "name": "gregoryduckworth/friendable",
    "description": "Add the possibility of friends quickly with the use of this trait.",
    "version": "0.2",
    "keywords": [
        "laravel",
        "friends",
        "friendable"
    ],
    "homepage": "https://github.com/gregoryduckworth/friendable",
    "license": "MIT",
    "authors": [
        {
            "name": "Gregory Duckworth",
            "email": "gregoryduckworth@users.noreply.github.com",
            "role": "Developer"
        }
    ],
    "require": {
        "illuminate/support": "^9.6|^10.0|^11.0|^12.0",
        "php" : "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit" : "^10.0",
        "scrutinizer/ocular": "~1.1",
        "mockery/mockery": "^1.5",
        "illuminate/database": "^9.6|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "GregoryDuckworth\\Friendable\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GregoryDuckworth\\Friendable\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "GregoryDuckworth\\Friendable\\FriendableServiceProvider"
            ]
        }
    }
}
